# Release signing config for the Play Store upload build.
#
# 1. Create your upload keystore (choose your OWN passwords; keep it safe and
#    backed up — losing it means you can't update the app):
#
#      keytool -genkey -v -keystore ~/keys/arrow-upload.jks \
#        -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# 2. Copy this file to android/key.properties (that path is gitignored) and fill
#    in the values below. Use an ABSOLUTE path for storeFile.
#
# 3. Build the upload bundle:
#
#      flutter build appbundle --release
#
# NEVER commit key.properties or the .jks file.

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=/absolute/path/to/arrow-upload.jks
